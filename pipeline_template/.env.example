# Copy to .env for local runs. Never commit .env. In Cloud Run set these as env vars / secrets instead.

# --- Identity ---
APP_NAME=pipeline-template
APP_TITLE=Document Insights Pipeline
URL_PATH_PREFIX=
APP_ENV=development            # production => SECRET_KEY is mandatory
SECRET_KEY=change-me           # python -c "import secrets; print(secrets.token_hex(32))"

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
GCS_BUCKET=your-bucket
GEMINI_MODEL=gemini-2.5-flash
# Local credentials: either run `gcloud auth application-default login`, or point at a key file kept OUTSIDE git:
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/key.json

# --- BigQuery ---
BQ_DATASET=PIPELINE_TEMPLATE
TABLE_PREFIX=tpl_
# Override single table names if needed:
# T_DOCUMENTS=tpl_documents
# T_FINDINGS=tpl_findings
# T_THEMES=tpl_themes
# T_SIGNALS=tpl_signals
# T_SCORES=tpl_scores
# T_REFERENCE=tpl_reference
# T_COMPARISON=tpl_comparison
# T_STATUS=tpl_status

# --- Behaviour ---
DEFAULT_YEAR=2026
MAX_THEMES=25
CONFIDENCE_FLOOR=0.55
SOURCES_TOTAL=0                # expected number of sources; 0 = count distinct sources found
AUTO_REFRESH=true              # run steps 2-5 after each parsed document
# BAND_HIGH_MIN=70
# BAND_MEDIUM_MIN=40
# SCORE_WEIGHT_COVERAGE=0.6
# SCORE_WEIGHT_INTENSITY=0.4
