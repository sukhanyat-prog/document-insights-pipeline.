# Copy to .env for local runs. Never commit .env. In Databricks Apps set these in app.yaml / app resources instead.

# --- Identity ---
APP_NAME=pipeline-template
APP_TITLE=Document Insights Pipeline
URL_PATH_PREFIX=
APP_ENV=development            # production => SECRET_KEY is mandatory
SECRET_KEY=change-me           # python -c "import secrets; print(secrets.token_hex(32))"

# --- Databricks (local development) ---
# Either run `databricks auth login --host https://<workspace>` and set DATABRICKS_CONFIG_PROFILE,
# or set a personal access token. Inside Databricks Apps / Jobs no credentials are needed.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=            # keep out of git; prefer the CLI profile
# DATABRICKS_CONFIG_PROFILE=DEFAULT
DATABRICKS_WAREHOUSE_ID=your-sql-warehouse-id

# --- Unity Catalog ---
DBX_CATALOG=main
DBX_SCHEMA=pipeline_template
DBX_VOLUME=documents
TABLE_PREFIX=tpl_
# Override single table names if needed:
# T_DOCUMENTS=tpl_documents
# T_FINDINGS=tpl_findings
# T_THEMES=tpl_themes
# T_SIGNALS=tpl_signals
# T_SCORES=tpl_scores
# T_REFERENCE=tpl_reference
# T_COMPARISON=tpl_comparison
# T_STATUS=tpl_status

# --- Model ---
LLM_ENDPOINT=databricks-meta-llama-3-3-70b-instruct
# LLM_JSON_MODE=true           # set false if the endpoint rejects response_format
# LLM_MAX_TOKENS=4096
# MAX_DOC_CHARS=120000

# --- Behaviour ---
DEFAULT_YEAR=2026
MAX_THEMES=25
CONFIDENCE_FLOOR=0.55
SOURCES_TOTAL=0                # expected number of sources; 0 = count distinct sources found
AUTO_REFRESH=true              # run steps 2-5 after each parsed document
# BAND_HIGH_MIN=70
# BAND_MEDIUM_MIN=40
# SCORE_WEIGHT_COVERAGE=0.6
# SCORE_WEIGHT_INTENSITY=0.4
