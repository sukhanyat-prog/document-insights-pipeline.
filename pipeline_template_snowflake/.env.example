# Copy to .env for local runs. Never commit .env. In Snowpark Container Services the service spec sets these instead.

# --- Identity ---
APP_NAME=pipeline-template
APP_TITLE=Document Insights Pipeline
URL_PATH_PREFIX=
APP_ENV=development            # production => SECRET_KEY is mandatory
SECRET_KEY=change-me           # python -c "import secrets; print(secrets.token_hex(32))"

# --- Snowflake connection (local development) ---
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=your_user
SNOWFLAKE_ROLE=PIPELINE_ROLE
SNOWFLAKE_WAREHOUSE=PIPELINE_WH
# Pick ONE authentication method:
SNOWFLAKE_AUTHENTICATOR=externalbrowser     # SSO in a browser window
# SNOWFLAKE_PRIVATE_KEY_PATH=C:/keys/rsa_key.p8   # key-pair auth (key kept outside git)
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# SNOWFLAKE_PASSWORD=                             # local only, never commit

# --- Where things live ---
SNOWFLAKE_DATABASE=PIPELINE_DB
SNOWFLAKE_SCHEMA=PIPELINE_TEMPLATE
SNOWFLAKE_STAGE=DOCUMENTS
TABLE_PREFIX=tpl_
# Override single table names if needed:
# T_DOCUMENTS=tpl_documents
# T_FINDINGS=tpl_findings
# T_THEMES=tpl_themes
# T_SIGNALS=tpl_signals
# T_SCORES=tpl_scores
# T_REFERENCE=tpl_reference
# T_COMPARISON=tpl_comparison
# T_STATUS=tpl_status

# --- Model ---
CORTEX_MODEL=mistral-large2
# MAX_DOC_CHARS=100000

# --- Behaviour ---
DEFAULT_YEAR=2026
MAX_THEMES=25
CONFIDENCE_FLOOR=0.55
SOURCES_TOTAL=0                # expected number of sources; 0 = count distinct sources found
AUTO_REFRESH=true              # run steps 2-5 after each parsed document
# BAND_HIGH_MIN=70
# BAND_MEDIUM_MIN=40
# SCORE_WEIGHT_COVERAGE=0.6
# SCORE_WEIGHT_INTENSITY=0.4
